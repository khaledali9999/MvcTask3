<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Movie Store</title>
  
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="~/css/StyleSheet.css" />
    <link rel="stylesheet" href="~/css/site.css" />


</head>
<body dir="rtl" >
    <nav class="navbar navbar-expand-lg shadow-sm" style="background: #ffffff; border-bottom: 1px solid #eee;">
        <div class="container">

            <a class="navbar-brand fw-bold" style="font-size: 22px; color: #1abc9c;" href="/Customer/Home/Index">
                الأسطورة سينما
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse mt-2 mt-lg-0" id="navbarSupportedContent">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link fw-bold" href="/Customer/Home/Index">الرئيسية</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link fw-bold" href="#">عنّا</a>
                    </li>

                    @if (!User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link fw-bold text-primary" href="/Identity/Account/Login">
                                تسجيل الدخول
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-primary px-3 py-1 rounded-3 ms-2 fw-bold" href="/Identity/Account/Register">
                                إنشاء حساب
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link fw-bold text-success" href="/Identity/Profile/Index">
                                أهلاً بك
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-bold" href="/Admin/Movie/Index">
                                لوحة التحكم
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-danger px-3 py-1 rounded-3 ms-2 fw-bold" href="/Identity/Account/LogOut">
                                خروج
                            </a>
                        </li>
                    }
                </ul>

            </div>

        </div>
    </nav>

   
   
    
  

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="text-center mt-5 mb-3 text-muted">
        &copy; @DateTime.Now.Year - Movie Store
    </footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    @await Html.PartialAsync("_NotificationPartial")
    @RenderSection("scripts", required: false)

</body>
 <partial name="_NotificationPartial" /> 

</html>
