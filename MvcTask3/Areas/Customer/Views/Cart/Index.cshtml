@model IEnumerable<MvcTask3.Models.Cart>

<h2>عربتي</h2>

@if (!Model.Any())
{
    <p>عربتك فارغة 😔</p>
}
else
{
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>الفيلم</th>
                <th>الكمية</th>
                <th>السعر لكل وحدة</th>
                <th>المجموع</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Movie.Name</td>
                    <td>@item.Count</td>
                    <td>@item.Movie.Price.ToString("C")</td>
                    <td>@(item.Count * item.Movie.Price).ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">الإجمالي</th>
                <th>@Model.Sum(c => c.Count * c.Movie.Price).ToString("C")</th>
            </tr>
        </tfoot>
    </table>
}
